# Copy to backend/.env and fill in. Never commit the real .env.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database (PostgreSQL) ---
# The same login you use in pgAdmin (right-click your server → Properties → Connection
# shows host, port and username). The password is the one chosen when PostgreSQL was
# installed (or for a role you created) — NOT the pgAdmin "master password".
# Special characters in the password are fine: no URL-encoding needed here.
#   local install:   localhost / 5432 / postgres / <your password>
#   docker compose:  localhost / 5433 / postgres / postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=sql_assistant
# Alternative: one complete URL (cloud providers give you this). If set, it wins over
# the five fields above. Special characters in the password must then be URL-encoded.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/sql_assistant

# --- Auth ---
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM (Groq, free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
LLM_MODEL_PRIMARY=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
# Default "thinking" for reasoning models when a request doesn't choose: low | medium | high
# (explanations default to low on their own; see app/llm/prompts.py)
LLM_REASONING_EFFORT=medium
# Upper bound per answer, reasoning tokens included
LLM_MAX_OUTPUT_TOKENS=4096
# json_schema (constrained decoding, gpt-oss only) | function_calling
LLM_STRUCTURED_OUTPUT_METHOD=json_schema
# Retries for network errors and 5xx only; rate limits switch model instead
LLM_MAX_RETRIES=2
# Optional price override in USD per 1M tokens (defaults: Groq list prices, Oct 2026)
# LLM_PRICES={"openai/gpt-oss-120b": {"input": 0.15, "output": 0.60, "cached_input": 0.075}}

# --- Schema ingestion (Phase 2) ---
# Vision model that reads schema screenshots, and its reasoning: none | default
LLM_MODEL_VISION=qwen/qwen3.8-27b
LLM_VISION_REASONING_EFFORT=none
# Upload limits in bytes (Groq accepts base64 images up to about 4 MB)
MAX_SQL_UPLOAD_BYTES=5000000
MAX_IMAGE_UPLOAD_BYTES=4000000
# How much schema text (table cards) one prompt may carry; the rest is reported as left out
SCHEMA_CONTEXT_MAX_CHARS=12000

# --- Tracing (LangSmith, optional) ---
# Free account: https://smith.langchain.com -> Settings -> API Keys. When enabled, the
# prompts and answers of every LLM call are sent to LangSmith so you can inspect them.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sqlassist-dev
# Only for EU-region LangSmith accounts:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
